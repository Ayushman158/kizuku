{
  "expo": {
    "name": "Kizuku",
    "slug": "kizuku",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "kizuku",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.kizuku.ios",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "app.kizuku.android",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF8EE"
      }
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    },
    "description": "One future worry, one grounded action, one day at a time.",
    "primaryColor": "#2C5228",
    "web": {
      "name": "Kizuku",
      "shortName": "Kizuku",
      "description": "One future worry, one grounded action, one day at a time.",
      "themeColor": "#B8D4AC",
      "backgroundColor": "#FBF8EE",
      "display": "standalone",
      "orientation": "portrait",
      "lang": "en"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FBF8EE"
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
